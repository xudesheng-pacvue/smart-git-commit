{
	"name": "smart-git-commit",
	"displayName": "Smart Git Commit",
	"description": "智能 Git Commit 助手，支持 Jira 集成和 Smart Commits",
	"version": "2.0.18",
	"author": {
		"name": "Ruomu Xu"
	},
	"publisher": "ruomu-xu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/xudesheng-pacvue/smart-git-commit"
	},
	"homepage": "https://github.com/xudesheng-pacvue/smart-git-commit#readme",
	"bugs": {
		"url": "https://github.com/xudesheng-pacvue/smart-git-commit/issues"
	},
	"engines": {
		"vscode": "^1.75.0"
	},
	"galleryBanner": {
		"color": "#fad000"
	},
	"keywords": [
		"git",
		"commit",
		"messages",
		"jira",
		"smart commits"
	],
	"categories": [
		"Other"
	],
	"icon": "images/icon.png",
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "smartCommit.configureJira",
				"title": "配置 Jira 集成",
				"category": "Smart Commit"
			}
		],
		"configuration": {
			"title": "Smart Git Commit",
			"properties": {
				"smartCommit.jira.apiUrl": {
					"type": "string",
					"default": "",
					"description": "Jira API URL (例如: https://your-domain.atlassian.net)"
				},
				"smartCommit.jira.email": {
					"type": "string",
					"default": "",
					"description": "Jira 账号邮箱"
				},
				"smartCommit.jira.apiToken": {
					"type": "string",
					"default": "",
					"description": "Jira API Token"
				},
				"smartCommit.jira.enabled": {
					"type": "boolean",
					"default": true,
					"description": "是否启用 Jira 集成功能"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile",
		"build": "rm -f ./*.vsix 2>/dev/null && npm version patch && vsce package"
	},
	"devDependencies": {
		"@types/glob": "^8.0.1",
		"@types/mocha": "^10.0.1",
		"@types/node": "^18.13.0",
		"@types/vscode": "^1.75.1",
		"glob": "^8.1.0",
		"mocha": "^10.2.0",
		"typescript": "^4.9.5"
	},
	"dependencies": {
		"axios": "^1.6.0"
	}
}
